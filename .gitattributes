# Canonical reference fixtures and generated code must survive checkout unchanged.
/tests/reference/*.csv text eol=lf
/tests/reference/*.txt text eol=lf
/tests/reference/*.json text eol=lf
/tests/reference/*.bin -text
# Wire 27's generated WAD, scripts and demo lumps are compared byte for byte (tools/reference/wire27_wad.py --check).
/tests/reference/wire27_*/** -text
/tools/reference/*.py text eol=lf
/tools/reference/*.h text eol=lf
/crates/doom-sim/src/fine_sine.rs text eol=lf
/crates/doom-types/src/rng_table.rs text eol=lf
/crates/doom-sim/src/tan_to_angle.rs text eol=lf
/tests/reference/m3b_maps.rs text eol=lf
# Historical documentation evidence is hashed byte-for-byte on every CI host.
/docs/validation/archive/*.txt -text
/docs/validation/archive/*.md text eol=lf
/docs/validation/archive/manifest.json text eol=lf

# Standard zstd source traces are binary and must survive checkout exactly.
/tests/reference/*.zst -text
/crates/doom-render/src/tables.rs text eol=lf

# id Software's original sources are kept as they were released: count them as vendored, not as
# this project's languages.
/linuxdoom-1.10/** linguist-vendored
/sndserv/** linguist-vendored
/ipx/** linguist-vendored
/sersrc/** linguist-vendored
# The harness headers are C; GitHub's detector guesses some of them as C++.
/tools/reference/*.h linguist-language=C
# The M6a part 2 goldens are compared byte for byte and must survive checkout unchanged.
/tests/reference/m6a2_*/* -text
# The victory-tic stops record is compared byte for byte (tools/reference/m6a2_victory_stops.py --check).
/tests/reference/m6a2_victory_stops/* -text
