/target/

# Local game data and private test output must never enter the public repository.
/iwads/
/local-assets/
/private-assets/
/private-fixtures/
/private-test-output/
.env
.env.*
*.[wW][aA][dD]
*.[lL][mM][pP]
*.[dD][eE][mM][oO]
*.[pP][kK]3
*.[pP][kK]7

# Local Python reference tooling caches
__pycache__/
*.py[cod]

# Synthetic demo inputs generated by tools/e1m1_scripts.py from committed scripts.
!/tests/reference/e1m1_scripts/*.lmp
!/tests/reference/m3h9c_scripts/*.lmp
!/tests/reference/m4a_scripts/*.lmp

# The synthetic game WAD generated by tools/reference/m3h9c_wad.py (no commercial data).
!/tests/reference/m3h9c_synthetic.wad
# The M4a mechanism-group WADs generated by tools/reference/m4a_wad.py (no commercial data).
!/tests/reference/m4a_wads/*.wad
