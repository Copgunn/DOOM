/corpus/wad/*
!/corpus/wad/empty_iwad
!/corpus/wad/duplicates
/corpus/map/*
!/corpus/map/classic_square

/corpus/actor_states/*
!/corpus/actor_states/native_chain

/corpus/combat/*
!/corpus/combat/bounded_attacks

/corpus/player_weapons/*
!/corpus/player_weapons/held_trigger

# Reproducible chaingunner seeds are documented; mutations remain local.
/corpus/chaingunner_attacks/

# Public Demon seeds are reproducible; evolving corpus stays local.
/corpus/demon_melee/

# Public lifecycle seed recipe is documented; mutations stay local.
/corpus/demon_lifecycle/

# New public composition seeds are reproducible from tools; mutations stay local.
/corpus/demon_expanded_map/

# Canonical identity seeds are reproducible; mutations stay local.
/corpus/original_identity/

# Canonical execution requests use the public seed recipe.
/corpus/canonical_demon/

# Native identity boundary seeds are reproducible; mutations remain local.
/corpus/runtime_identity/
